<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Ranks.Contract</AssemblyName>
    <RootNamespace>Ranks.Contract</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 wants a doc comment on every public member. The XML file is worth shipping for the
         members that carry a real one, but satisfying it everywhere means writing "Gets the core."
         on RanksModuleBase.Core — noise the repo's comment policy rules out. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <OutputPath>$(MSBuildThisFileDirectory)build/</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- "*-*" = newest including prereleases, matching Ranks.csproj. The contract names only
         IPlayer and ISwiftlyCore (FR-API-01), so it never loads the framework at runtime. -->
    <PackageReference Include="SwiftlyS2.CS2" Version="*-*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
