<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>Ranks</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)build/</OutputPath>
    <PublishDir>$(OutputPath)publish/Ranks</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- "10.*" tracks SwiftlyS2's floor: it floats its own Microsoft.Extensions minimum, and a fixed version here becomes a downgrade error on the next beta. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- "*-*" = newest version including prereleases. Core.Menu (FR-CMD-06) ships only in the 1.5.0 betas. -->
    <PackageReference Include="SwiftlyS2.CS2" Version="*-*" ExcludeAssets="runtime" PrivateAssets="all" />

    <!-- Shipped normally, unlike the references above: SwiftlyS2 does not provide FluentMigrator,
         so ExcludeAssets="runtime" would compile and then fail to resolve at load.
         Runner.Core, not the FluentMigrator.Runner meta-package — that one drags in runners for
         SqlServer, Oracle, Db2, Firebird, Hana, Redshift and Snowflake, and with them a
         Microsoft.Data.SqlClient chain carrying a high-severity Pkcs advisory (NU1903). -->
    <PackageReference Include="FluentMigrator" Version="8.*" />
    <PackageReference Include="FluentMigrator.Runner.Core" Version="8.*" />
    <PackageReference Include="FluentMigrator.Runner.MySql" Version="8.*" />
    <PackageReference Include="FluentMigrator.Runner.Postgres" Version="8.*" />
    <PackageReference Include="FluentMigrator.Runner.SQLite" Version="8.*" />

    <!-- One ADO driver per engine FR-DB-01 claims. SwiftlyS2 depends on all three, but it is
         referenced ExcludeAssets="runtime" above, which strips its transitive runtime assets too —
         so none of them reach this plugin's folder or its .deps.json, and the host's copies are not
         a substitute: McMaster.NETCore.Plugins resolves a plugin's assemblies from that deps.json,
         and FluentMigrator opens its own connection from the connection string rather than taking
         the host's. Naming them directly is what puts them next to Ranks.dll; without that the
         runner throws before the first CREATE TABLE and the database silently stays empty.
         Versions track SwiftlyS2's own so one driver is loaded, not two: a lower floor trips
         NU1605. The names are what each runner probes for and cannot be swapped — MySqlConnector
         (or MySql.Data), Npgsql, System.Data.SQLite (or Microsoft.Data.Sqlite). -->
    <PackageReference Include="MySqlConnector" Version="2.*" />
    <PackageReference Include="Npgsql" Version="10.*" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false: the host loads resources/exports/Ranks.Contract.dll once and every module
         binds to that instance. A second copy beside Ranks.dll gives IRanksApi two Type identities
         and TryGetSharedInterface silently stops matching (FR-API-00). -->
    <ProjectReference Include="../Ranks.Contract/Ranks.Contract.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="resources/gamedata/**/*;resources/templates/**/*;resources/translations/**/*;resources/examples/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="examples\**\*.cs" />
  </ItemGroup>

  <UsingTask TaskName="ExtractPluginVersion"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
      <PluginVersion ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          var content = System.IO.File.ReadAllText(FilePath);
          var m = System.Text.RegularExpressions.Regex.Match(content, "Version\\s*=\\s*\"([^\"]+)\"");
          PluginVersion = m.Success ? m.Groups[1].Value : "";
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- Resolved inside a target, never in an item glob: the contract DLL does not exist during
       project evaluation, so a glob ships nothing from a clean checkout and fails only at runtime
       with a ReflectionTypeLoadException (guide §9.1).

       Only core's own contract ships from here. A module that publishes an API owns and ships its
       own contract, so adding one never touches this project. -->
  <Target Name="CopyContract" AfterTargets="Build">
    <PropertyGroup>
      <_ContractDll>$(MSBuildThisFileDirectory)../Ranks.Contract/build/$(TargetFramework)/Ranks.Contract.dll</_ContractDll>
    </PropertyGroup>
    <Error Condition="!Exists('$(_ContractDll)')"
           Text="CopyContract: $(_ContractDll) is missing. Build Ranks.Contract first." />
    <Copy SourceFiles="$(_ContractDll)" DestinationFolder="$(OutDir)resources/exports" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyContractToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_ContractDll>$(MSBuildThisFileDirectory)../Ranks.Contract/build/$(TargetFramework)/Ranks.Contract.dll</_ContractDll>
    </PropertyGroup>
    <Error Condition="!Exists('$(_ContractDll)')"
           Text="CopyContractToPublish: $(_ContractDll) is missing. Build Ranks.Contract first." />
    <Copy SourceFiles="$(_ContractDll)" DestinationFolder="$(PublishDir)resources/exports" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CreateZip" AfterTargets="Publish">
    <ExtractPluginVersion FilePath="$(MSBuildThisFileDirectory)src\Entrypoint.cs">
      <Output TaskParameter="PluginVersion" PropertyName="_PluginVersion" />
    </ExtractPluginVersion>
    <Error Condition="'$(_PluginVersion)' == ''"
           Text="CreateZip: failed to extract PluginMetadata.Version from src\Entrypoint.cs." />

    <ItemGroup>
      <PublishFiles Include="$(PublishDir)**\*.*" />
    </ItemGroup>
    
    <ZipDirectory SourceDirectory="$(PublishDir)../" DestinationFile="$(OutputPath)../$(AssemblyName)-v$(_PluginVersion).zip" Overwrite="true" />
  </Target>

</Project> 
