{
  // Ranks - українська.
  //
  // Цей файл має містити ВСІ ключі. Відсутній ключ показується гравцеві як буквальний маркер
  // {lang}.{key} замість англійського тексту, тому частковий переклад гірший за його відсутність.
  //
  // {0}, {1}, ... — позиційні аргументи; залишайте їх у кожному перекладі, навіть якщо змінюється
  // порядок слів. Кольорові токени ([gold], [lime], [default], ...) — це кольори чату SwiftlyS2.

  "prefix": "[ [darkred]Ранги [default]] ",

  // ---- Помилки ------------------------------------------------------------

  "error.players_only": "[red]Цю команду може використовувати лише гравець.",
  "error.not_loaded": "[red]Ваші дані рангу ще не завантажені. Спробуйте за мить.",

  // ---- Відгук про XP ------------------------------------------------------

  "XP.gained": "[lime]+{0}[default] XP [grey]({1})",
  "XP.lost": "[red]-{0}[default] XP [grey]({1})",

  // Навмисно без причин: їх називають рядки окремих подій, а цей рядок замінює їх, а не підсумовує.
  "XP.summary": "[default]Підсумок раунду: [gold]{0}{1}[default] XP",

  // ---- Зміни рангу --------------------------------------------------------

  "rank.promoted": "[green]Підвищення рангу![default] Тепер ваш ранг — [gold]{0}[default], у вас [lime]{1}[default] XP.",
  "rank.demoted": "[red]Пониження рангу.[default] Тепер ваш ранг — [gold]{0}[default], у вас [lime]{1}[default] XP.",

  // ---- Самоскидання -------------------------------------------------------

  "reset.confirm": "[red]Це видалить ваші поточні XP та статистику.[default] Введіть команду ще раз протягом [gold]{0}[default] с для підтвердження.",
  "reset.done": "[green]Ваш ранг скинуто.",

  // ---- Ігровий час --------------------------------------------------------
  //
  // Час, проведений на сервері, рахується так само, як у K4-LevelRanks: розминка, спостереження
  // та порожній сервер включно. {0} у перших двох — тривалість, складена з ключів duration.*.

  "playtime.mine": "Ви провели на цьому сервері [gold]{0}[default].",
  // Замінює playtime.mine, коли увімкнено сезони і показано час поточного сезону.
  "playtime.mine_season": "Ви провели на цьому сервері [gold]{0}[default] протягом цього сезону.",
  // {0} — позиція гравця, {1} — кількість гравців у рейтингу.
  "playtime.position": "Ви на [gold]#{0}[default] місці з [gold]{1} гравців[default] за ігровим часом.",
  "playtime.position_season": "Ви на [gold]#{0}[default] місці з [gold]{1} гравців[default] за ігровим часом цього сезону.",

  // Тривалість, від найбільшої одиниці; нульові старші одиниці опускаються. {0} дні, {1} години,
  // {2} хвилини; потім {0} години, {1} хвилини; потім {0} хвилини.
  "duration.days": "{0}д {1}г {2}хв",
  "duration.hours": "{0}г {1}хв",
  "duration.minutes": "{0}хв",

  // ---- Сезони -------------------------------------------------------------
  //
  // Лише коли сезони увімкнено: Database.VirtualPurgeMode 1 (щомісяця) або VirtualPurgeDays
  // більше нуля. Сезон — це один період: коли він закінчується, ранг усіх починається заново,
  // а завершений сезон залишається доступним у таблиці лідерів.

  "period.started": "[gold]Розпочався новий сезон![default] Ранг усіх гравців починається заново. Підсумки минулого сезону збережено в розділі [gold]Таблиця лідерів[default].",

  // ---- Адміністратор ------------------------------------------------------

  "admin.usage": "[red]Використання:[default] {0} <ціль> <кількість>",
  // Без кількості: ця команда приймає лише ціль.
  "admin.usage_target": "[red]Використання:[default] {0} <ціль>",
  "admin.bad_amount": "[red]'{0}' не є числом.",
  "admin.no_target": "[red]Жодного гравця не знайдено за '{0}'.",
  "admin.ambiguous_target": "[red]За '{0}' знайдено кількох гравців. Вкажіть більшу частину імені або SteamID чи status id.",
  "admin.not_loaded": "[red]Дані рангу гравця {0} ще не завантажені. Спробуйте за мить.",
  "admin.adjusted": "[lime]{0}[default] тепер має [gold]{1}[default] XP.",
  "admin.reset": "[lime]{0}[default] скинуто.",

  // ---- Допомога -----------------------------------------------------------
  //
  // Чат, а не рядки меню: рядок меню — це один центрований рядок, що обрізається приблизно на
  // 42 символах. Тут теги чату, не HTML.
  //
  // {0} — НАЛАШТОВАНА назва команди з commands.jsonc без префікса ! — тож перейменована команда
  // описує себе правильно, а видалена взагалі не показується. Залишайте буквальний "!" перед {0}.

  "help.header": "[gold]Доступні команди:",
  "help.rank": "[gold]!{0} [default]- Ваша детальна статистика, налаштування та інформація про ранги",
  "help.stats": "[gold]!{0} [default]- Меню вашої статистики",
  "help.mytime": "[gold]!{0} [default]- Скільки ви награли на цьому сервері",
  "help.ranks": "[gold]!{0} [default]- Усі доступні ранги",
  "help.top": "[gold]!{0} [default]- Таблиця лідерів. Оберіть гравця, щоб переглянути його статистику",
  "help.ttop": "[gold]!{0} [default]- Таблиця лідерів за ігровим часом, ваша позиція показується в чаті",
  "help.resetmyrank": "[gold]!{0} [default]- Видаляє ваші XP та статистику. Спершу просить підтвердження",

  // Показується лише гравцеві, який має право хоча б на одну з цих команд, і кожен рядок — лише
  // тому, хто може її виконати, тож це ніколи не рекламує те, що буде відхилено. {0} — налаштована
  // назва, як вище.

  "help.admin_header": "[gold]Команди адміністратора:",
  "help.setpoints": "[gold]!{0} [grey]<ціль Ім'я/SteamID/StatusID> <кількість> [default]- Встановлює цілі точну кількість XP",
  "help.givepoints": "[gold]!{0} [grey]<ціль Ім'я/SteamID/StatusID> <кількість> [default]- Додає цілі XP",
  "help.removepoints": "[gold]!{0} [grey]<ціль Ім'я/SteamID/StatusID> <кількість> [default]- Віднімає в цілі XP",
  "help.resetrank": "[gold]!{0} [grey]<ціль Ім'я/SteamID/StatusID> [default]- Видаляє XP та статистику цілі",

  // ---- Меню ---------------------------------------------------------------
  //
  // Весь інтерфейс для гравця живе тут: !rank відкриває корінь, а кожна інша команда — це
  // скорочення до однієї з його гілок. Для налаштувань і допомоги окремих команд немає.

  "menu.root.title": "Ранги",
  "menu.root.rank": "Мій ранг",
  "menu.root.stats": "Статистика",
  "menu.root.top": "Таблиця лідерів",
  "menu.root.settings": "Налаштування",
  "menu.root.help": "Допомога (у чаті)",
  // Показується лише гравцеві, який може виконати хоча б одну команду адміністратора.
  "menu.root.admin": "Команди адміністратора (у чаті)",

  "menu.rank.title": "Ваш ранг",
  "menu.rank.current": "Ранг: {0}",
  "menu.rank.XP": "XP: {0}",
  "menu.rank.next": "{0} — ще {1} XP",
  "menu.rank.top_band": "Досягнуто найвищого рангу",
  "menu.rank.ladder": "Показати всі ранги",

  "menu.ladder.title": "Сходи рангів",
  "menu.ladder.row": "{0} - {1} XP",
  "menu.ladder.row_current": "> {0} - {1} XP",

  "menu.stats.title": "Статистика",
  "menu.stats.main": "Основна статистика",
  "menu.stats.main_title": "Основна статистика",
  // Три рядки нижче замінюють "Основна статистика", коли сезони увімкнено.
  "menu.stats.current": "Цей сезон",
  "menu.stats.alltime": "Статистика за весь час",
  "menu.stats.previous": "Попередні сезони",
  "menu.stats.kills": "Вбивства: {0}",
  "menu.stats.deaths": "Смерті: {0}",
  "menu.stats.kd": "K/D: {0}",
  "menu.stats.assists": "Асисти: {0}",
  "menu.stats.headshots": "Хедшоти: {0} ({1}% від вбивств)",
  "menu.stats.accuracy": "Влучність: {0}% ({1} влучань, {2} промахів)",
  "menu.stats.rounds": "Раунди: {0} виграно, {1} програно",
  "menu.stats.matches": "Матчі: {0} виграно, {1} програно",
  "menu.stats.bombs": "Бомби: {0} закладено, {1} знешкоджено",
  // {0} — тривалість, складена з ключів duration.*.
  "menu.stats.playtime": "Ігровий час: {0}",
  "menu.stats.modules_empty": "Модулі статистики не встановлено.",

  "menu.settings.title": "Налаштування",
  "menu.settings.XP_messages": "Повідомлення про XP",
  "menu.settings.reset": "Скинути мій ранг",
  "menu.settings.reset_title": "Скинути мій ранг",
  "menu.settings.reset_warning": "Це видалить ваші поточні XP та статистику. Цю дію неможливо скасувати.",
  "menu.settings.reset_confirm": "Так, скинути все",

  "menu.top.title": "Таблиця лідерів",
  "menu.top.row": "#{0} {1} - {2}",
  "menu.top.hint": "Оберіть, щоб переглянути статистику цього гравця",
  "menu.top.empty": "Поки що ніхто не потрапив до рейтингу.",
  "menu.top.error": "Таблиця лідерів зараз недоступна.",
  // Рядки екрана таблиці лідерів. Players — це дошка XP, коли сезони вимкнено; коли вони
  // увімкнені, її замінюють три сезонні рядки.
  "menu.top.players": "Гравці",
  "menu.top.current": "Цей сезон",
  "menu.top.alltime": "За весь час",
  "menu.top.previous": "Попередні сезони",
  "menu.top.playtime": "Ігровий час",

  // Дошка ігрового часу, відкривається з рядка Playtime або через !ttop. {0} позиція, {1} ім'я,
  // {2} тривалість, складена з ключів duration.*.
  "menu.toptime.title": "Топ за ігровим часом",
  "menu.toptime.row": "#{0} {1} - {2}",

  "menu.period.title": "Попередні сезони",
  // {0} — перший день сезону у форматі yyyy-MM-dd за UTC. Використовується для сезону, який не
  // був рівно одним календарним місяцем.
  "menu.period.row": "Сезон від {0}",
  // Сезон, що тривав рівно один календарний місяць за UTC. {0} — month.N нижче, {1} — рік.
  "menu.period.month": "{0} {1}",
  // Усе, що записано до ввімкнення сезонів.
  "menu.period.initial": "До сезонів",
  // {0} — останній повний день сезону, yyyy-MM-dd за UTC; наступний сезон починається о 00:00 UTC
  // наступного дня. Тримайте коротко: рядок, ширший за меню, обрізається.
  "menu.period.last_day": "Останній день: {0}",
  // Замінює menu.period.last_day, поки поточний сезон — календарний місяць. {0} — це
  // menu.period.month. Залишайте після двокрапки, щоб мова могла не відмінювати назву місяця.
  "menu.period.current_month": "Сезон: {0}",
  "menu.period.empty": "Попередніх сезонів ще немає.",

  // Назви місяців для menu.period.month, шукаються як "month." + 1-12.
  "month.1": "Січень",
  "month.2": "Лютий",
  "month.3": "Березень",
  "month.4": "Квітень",
  "month.5": "Травень",
  "month.6": "Червень",
  "month.7": "Липень",
  "month.8": "Серпень",
  "month.9": "Вересень",
  "month.10": "Жовтень",
  "month.11": "Листопад",
  "month.12": "Грудень",

  // {0} — збережене ім'я гравця.
  "menu.playerstats.title": "{0}",
  "menu.playerstats.empty": "У цього гравця немає збереженої статистики.",

  // ---- Довідка по командах ------------------------------------------------
  //
  // Показується через sw_help. Це не поле конфігурації: воно призначене для гравця, тож
  // перекладається.

  // Ключ — це ключ команди в commands.jsonc, а не її відображувана назва: пошук іде за
  // command.{key}.help, тому перейменування під "XP" дасть сирий маркер.
  "command.rank.help": "Відкрити меню рангів.",
  "command.ranks.help": "Показати всі ранги.",
  "command.top.help": "Показати таблицю лідерів за XP.",
  "command.stats.help": "Показати вашу статистику.",
  "command.mytime.help": "Показати, скільки ви награли на цьому сервері.",
  "command.ttop.help": "Показати таблицю лідерів за ігровим часом.",
  "command.resetmyrank.help": "Скинути ваші XP та статистику. Потребує підтвердження.",
  "command.setpoints.help": "Встановити гравцеві точну кількість XP.",
  "command.givepoints.help": "Додати гравцеві XP.",
  "command.removepoints.help": "Відняти в гравця XP.",
  "command.resetrank.help": "Скинути XP та статистику гравця.",

  // ---- Назви подій --------------------------------------------------------
  //
  // Підпис, що показується в повідомленні про XP. Перекладаються лише власні ключі ядра; якщо
  // модуль викликає AddXP зі своїм рядком причини, цей рядок показується як є, бо ядро не може
  // постачати ключ для причини, про яку не знає.

  "event.kill": "Вбивство",
  "event.death": "Смерть",
  "event.assist": "Асист",
  "event.assist_flash": "Асист флешкою",
