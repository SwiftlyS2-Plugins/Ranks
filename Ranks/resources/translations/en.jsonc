{
  // Ranks - English.
  //
  // This file must stay KEY-COMPLETE. A missing key renders the literal marker {lang}.{key} to
  // the player rather than falling back to English, so a partial translation is worse than none.
  //
  // {0}, {1}, ... are positional arguments; keep them in every translation even if the word order
  // changes. Colour tokens ([gold], [lime], [default], ...) are SwiftlyS2's chat colours.

  "prefix": "[ [gold]Ranks[default] ] ",

  // ---- Errors -------------------------------------------------------------

  "error.players_only": "[red]That command can only be used by a player.",
  "error.not_loaded": "[red]Your rank data has not loaded yet. Try again in a moment.",

  // ---- Point feedback -----------------------------------------------------

  "points.gained": "[lime]+{0}[default] points for [gold]{1}[default]. Total: [lime]{2}[default].",
  "points.lost": "[red]-{0}[default] points for [gold]{1}[default]. Total: [lime]{2}[default].",

  // Used instead of the two above when Points.ShowPlayerNames is on and there is a counterparty.
  "points.gained_vs": "[lime]+{0}[default] points for [gold]{1}[default] against [lime]{2}[default]. Total: [lime]{3}[default].",
  "points.lost_vs": "[red]-{0}[default] points for [gold]{1}[default] against [lime]{2}[default]. Total: [lime]{3}[default].",

  "points.summary": "Round total: [gold]{0}{1}[default] points. You now have [lime]{2}[default].",

  // ---- Rank changes -------------------------------------------------------

  "rank.promoted": "[green]Rank up![default] You are now [gold]{0}[default] with [lime]{1}[default] points.",
  "rank.demoted": "[red]Rank down.[default] You are now [gold]{0}[default] with [lime]{1}[default] points.",

  // ---- Settings -----------------------------------------------------------

  "settings.point_messages_on": "[green]Point messages enabled.",
  "settings.point_messages_off": "[red]Point messages disabled.",

  // ---- Self reset ---------------------------------------------------------

  "reset.confirm": "[red]This wipes your points and statistics.[default] Type the command again within [gold]{0}[default] seconds to confirm.",
  "reset.done": "[green]Your rank has been reset.",

  // ---- Admin --------------------------------------------------------------

  "admin.usage": "[red]Usage:[default] {0} <target> <amount>",
  "admin.bad_amount": "[red]'{0}' is not a number.",
  "admin.no_target": "[red]No player matched '{0}'.",
  "admin.adjusted": "[lime]{0}[default] now has [gold]{1}[default] points.",
  "admin.reset": "[lime]{0}[default] has been reset.",

  // ---- Statistics ---------------------------------------------------------

  "stats.header": "[gold]Your statistics:",
  "stats.combat": "Kills [lime]{0}[default] | Deaths [red]{1}[default] | Assists [lime]{2}[default] | K/D [gold]{3}[default]",
  "stats.rounds": "Rounds won [lime]{0}[default] | lost [red]{1}[default]",
  "stats.matches": "Matches won [lime]{0}[default] | lost [red]{1}[default]",
  "stats.bombs": "Bombs planted [lime]{0}[default] | defused [lime]{1}[default]",

  // ---- Menus --------------------------------------------------------------

  "menu.rank.title": "Your rank",
  "menu.rank.current": "Rank: {0}",
  "menu.rank.points": "Points: {0}",
  "menu.rank.next": "{0} in {1} points",
  "menu.rank.top_band": "Highest rank reached",
  "menu.rank.ladder": "Show all ranks",
  "menu.rank.stats": "Show my statistics",

  "menu.ladder.title": "Rank ladder",
  "menu.ladder.row": "{0} - {1} points",
  "menu.ladder.row_current": "> {0} - {1} points",

  "menu.settings.title": "Settings",
  "menu.settings.point_messages": "Point messages",

  "menu.top.title": "Leaderboard",
  "menu.top.row": "#{0} {1} - {2}",
  "menu.top.empty": "Nobody is ranked yet.",
  "menu.top.error": "The leaderboard is unavailable right now.",

  // ---- Command help -------------------------------------------------------
  //
  // Shown by sw_help. Not a config field: it is player-facing, so it is translatable.

  "command.rank.help": "Show your rank, points and progress to the next band.",
  "command.ranks.help": "Show the full rank ladder.",
  "command.top.help": "Show the points leaderboard.",
  "command.stats.help": "Show your kills, deaths and objective statistics.",
  "command.settings.help": "Open your Ranks preferences.",
  "command.resetmyrank.help": "Reset your own points and statistics. Requires confirmation.",
  "command.togglepointmsg.help": "Turn your point chat messages on or off.",
  "command.setpoints.help": "Set a player's points to an exact value.",
  "command.givepoints.help": "Add points to a player.",
  "command.removepoints.help": "Subtract points from a player.",
  "command.resetrank.help": "Reset a player's points and statistics.",

  // ---- Event names --------------------------------------------------------
  //
  // The label shown in a point message. Only core's own keys are translated; a module calling
  // AddPoints with its own reason string has that string shown verbatim, since core cannot ship
  // a key for a reason it has never heard of.

  "event.core.kill": "a kill",
  "event.core.death": "dying",
  "event.core.assist": "an assist",
  "event.core.assist_flash": "a flash assist",
  "event.core.headshot": "a headshot",
  "event.core.suicide": "a suicide",
  "event.core.team_kill": "a team kill",
  "event.core.team_assist": "a team assist",
  "event.core.noscope": "a no-scope",
  "event.core.wallbang": "a wallbang",
  "event.core.through_smoke": "a kill through smoke",
  "event.core.blind_kill": "a blind kill",
  "event.core.long_distance": "a long-distance kill",
  "event.core.knife_kill": "a knife kill",
  "event.core.taser_kill": "a taser kill",
  "event.core.grenade_kill": "a grenade kill",
  "event.core.inferno_kill": "a fire kill",
  "event.core.impact_kill": "an impact kill",
  "event.core.bomb_plant": "planting the bomb",
  "event.core.bomb_defuse": "defusing the bomb",
  "event.core.bomb_defuse_others": "your team defusing the bomb",
  "event.core.bomb_exploded": "the bomb exploding",
  "event.core.bomb_pickup": "picking up the bomb",
  "event.core.bomb_drop": "dropping the bomb",
  "event.core.hostage_rescue": "rescuing a hostage",
  "event.core.hostage_rescue_all": "all hostages rescued",
  "event.core.hostage_hurt": "hurting a hostage",
  "event.core.hostage_kill": "killing a hostage",
  "event.core.round_win": "winning the round",
  "event.core.round_lose": "losing the round",
  "event.core.mvp": "being round MVP",
  "event.core.match_win": "winning the match",
  "event.core.match_lose": "losing the match",

  "event.core.streak_double": "a double kill",
  "event.core.streak_triple": "a triple kill",
  "event.core.streak_domination": "a domination",
  "event.core.streak_rampage": "a rampage",
  "event.core.streak_mega": "a mega kill",
  "event.core.streak_ownage": "ownage",
  "event.core.streak_ultra": "an ultra kill",
  "event.core.streak_killing_spree": "a killing spree",
  "event.core.streak_monster": "a monster kill",
  "event.core.streak_unstoppable": "being unstoppable",
  "event.core.streak_godlike": "being godlike"
}
