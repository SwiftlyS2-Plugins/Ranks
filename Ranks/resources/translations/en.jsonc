{
  // Ranks - English.
  //
  // This file must stay KEY-COMPLETE. A missing key renders the literal marker {lang}.{key} to
  // the player rather than falling back to English, so a partial translation is worse than none.
  //
  // {0}, {1}, ... are positional arguments; keep them in every translation even if the word order
  // changes. Colour tokens ([gold], [lime], [default], ...) are SwiftlyS2's chat colours.

  "prefix": "[ [darkred]Ranks [default]] ",

  // ---- Errors -------------------------------------------------------------

  "error.players_only": "[red]This command can only be used by a player.",
  "error.not_loaded": "[red]Your rank data has not loaded yet. Try again in a moment.",

  // ---- XP feedback -----------------------------------------------------

  "XP.gained": "[lime]+{0}[default] XP [grey]({1})",
  "XP.lost": "[red]-{0}[default] XP [grey]({1})",

  // Deliberately carries no reasons: the per-event lines are what name them, and this replaces
  // those lines rather than summarising them.
  "XP.summary": "[default]Round summary: [gold]{0}{1}[default] XP",

  // ---- Rank changes -------------------------------------------------------

  "rank.promoted": "[green]Rank up![default] You are now [gold]{0}[default] with [lime]{1}[default] XP.",
  "rank.demoted": "[red]Rank down.[default] You are now [gold]{0}[default] with [lime]{1}[default] XP.",

  // ---- Settings -----------------------------------------------------------

  "settings.XP_messages_on": "[green]XP messages enabled.",
  "settings.XP_messages_off": "[red]XP messages disabled.",

  // ---- Self reset ---------------------------------------------------------

  "reset.confirm": "[red]This wipes your XP and statistics.[default] Type the command again within [gold]{0}[default] seconds to confirm.",
  "reset.done": "[green]Your rank has been reset.",

  // ---- Admin --------------------------------------------------------------

  "admin.usage": "[red]Usage:[default] {0} <target> <amount>",
  "admin.bad_amount": "[red]'{0}' is not a number.",
  "admin.no_target": "[red]No player matched '{0}'.",
  "admin.adjusted": "[lime]{0}[default] now has [gold]{1}[default] XP.",
  "admin.reset": "[lime]{0}[default] has been reset.",

  // ---- Statistics ---------------------------------------------------------

  "stats.header": "[gold]Your statistics:",
  "stats.combat": "Kills [lime]{0}[default] | Deaths [red]{1}[default] | Assists [lime]{2}[default] | K/D [gold]{3}[default]",
  "stats.rounds": "Rounds won [lime]{0}[default] | lost [red]{1}[default]",
  "stats.matches": "Matches won [lime]{0}[default] | lost [red]{1}[default]",
  "stats.bombs": "Bombs planted [lime]{0}[default] | defused [lime]{1}[default]",

  // ---- Menus --------------------------------------------------------------

  "menu.rank.title": "Your rank",
  "menu.rank.current": "Rank: {0}",
  "menu.rank.XP": "XP: {0}",
  "menu.rank.next": "{0} in {1} XP",
  "menu.rank.top_band": "Highest rank reached",
  "menu.rank.ladder": "Show all ranks",
  "menu.rank.stats": "Show my statistics",

  "menu.ladder.title": "Rank ladder",
  "menu.ladder.row": "{0} - {1} XP",
  "menu.ladder.row_current": "> {0} - {1} XP",

  "menu.settings.title": "Settings",
  "menu.settings.XP_messages": "XP messages",

  "menu.top.title": "Leaderboard",
  "menu.top.row": "#{0} {1} - {2}",
  "menu.top.empty": "Nobody is ranked yet.",
  "menu.top.error": "The leaderboard is unavailable right now.",

  // ---- Command help -------------------------------------------------------
  //
  // Shown by sw_help. Not a config field: it is player-facing, so it is translatable.

  // Keyed on the command's key in commands.jsonc, not on the display wording — the lookup is
  // command.{key}.help, so renaming these to match "XP" would render a raw marker instead.
  "command.rank.help": "Show your rank, XP and progress to the next band.",
  "command.ranks.help": "Show the full rank ladder.",
  "command.top.help": "Show the XP leaderboard.",
  "command.stats.help": "Show your kills, deaths and objective statistics.",
  "command.settings.help": "Open your Ranks preferences.",
  "command.resetmyrank.help": "Reset your own XP and statistics. Requires confirmation.",
  "command.togglepointmsg.help": "Turn your XP chat messages on or off.",
  "command.setpoints.help": "Set a player's XP to an exact value.",
  "command.givepoints.help": "Add XP to a player.",
  "command.removepoints.help": "Subtract XP from a player.",
  "command.resetrank.help": "Reset a player's XP and statistics.",

  // ---- Event names --------------------------------------------------------
  //
  // The label shown in a XP message. Only core's own keys are translated; a module calling
  // AddXP with its own reason string has that string shown verbatim, since core cannot ship
  // a key for a reason it has never heard of.

  "event.kill": "Kill",
  "event.death": "Death",
  "event.assist": "Assist",
  "event.assist_flash": "Flash Assist",
  "event.headshot": "Headshot",
  "event.suicide": "Suicide",
  "event.team_kill": "Team Kill",
  "event.team_assist": "Team Assist",
  "event.noscope": "No Scope",
  "event.wallbang": "Wallbang",
  "event.through_smoke": "Through Smoke",
  "event.blind_kill": "Blind Kill",
  "event.long_distance": "Long Distance",
  "event.knife_kill": "Knife Kill",
  "event.taser_kill": "Zeus Kill",
  "event.grenade_kill": "Grenade Kill",
  "event.inferno_kill": "Molotov/Incendiary Kill",
  "event.impact_kill": "Impact Kill",
  "event.bomb_plant": "Bomb Plant",
  "event.bomb_defuse": "Bomb Defuse",
  "event.bomb_defuse_others": "Bomb Defused",
  "event.bomb_exploded": "Bomb Exploded",
  "event.bomb_pickup": "Bomb Pickup",
  "event.bomb_drop": "Bomb Drop",
  "event.hostage_rescue": "Hostage Rescue",
  "event.hostage_rescue_all": "All Hostages Rescued",
  "event.hostage_hurt": "Hostage Hurt",
  "event.hostage_kill": "Hostage Kill",
  "event.round_win": "Round Win",
  "event.round_lose": "Round Loss",
  "event.mvp": "MVP",
  "event.match_win": "Match Win",
  "event.match_lose": "Match Loss",

  "event.streak.double": "Double Kill",
  "event.streak.triple": "Triple Kill",
  "event.streak.domination": "Domination",
  "event.streak.rampage": "Rampage",
  "event.streak.mega": "Mega Kill",
  "event.streak.ownage": "Ownage",
  "event.streak.ultra": "Ultra Kill",
  "event.streak.killing_spree": "Killing Spree",
  "event.streak.monster": "Monster Kill",
  "event.streak.unstoppable": "Unstoppable",
  "event.streak.godlike": "GODLIKE"
}
