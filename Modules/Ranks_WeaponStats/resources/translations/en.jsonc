{
  // Ranks_WeaponStats - English.
  //
  // Must stay KEY-COMPLETE: a missing key renders the literal marker {lang}.{key} to the player
  // rather than falling back to English.

  "error.players_only": "[red]That command can only be used by a player.",
  "error.unavailable": "[red]Weapon statistics are unavailable right now.",

  // ---- Menus --------------------------------------------------------------
  //
  // The two titles double as the labels core shows under its Statistics menu, so renaming one
  // renames the row there too.

  "menu.error": "These statistics are unavailable right now.",

  "menu.weapons.title": "Weapon stats",
  "menu.weapons.empty": "You have no weapon statistics yet.",
  "menu.weapons.hint": "Select to see where this weapon's hits landed",
  // Rows are one centred line and clip at roughly 42 characters, so damage is left to the API.
  "menu.weapons.row": "{0} | {1} Kills, {2}% HS, {3}% Accuracy",

  "menu.hitgroups.title": "Overall Hit Stats",
  "menu.hitgroups.empty": "You have not landed any hits yet.",
  "menu.hitgroups.row": "{0}: {1} hits ({2}%), {3} dmg",

  // {0} is the weapon, already stripped of its weapon_ prefix and upper-cased.
  "menu.weaponhits.title": "{0} - Hit Stats",

  "hitgroup.generic": "Generic",
  "hitgroup.head": "Head",
  "hitgroup.chest": "Chest",
  "hitgroup.stomach": "Stomach",
  "hitgroup.left_arm": "Left arm",
  "hitgroup.right_arm": "Right arm",
  "hitgroup.left_leg": "Left leg",
  "hitgroup.right_leg": "Right leg",
  "hitgroup.neck": "Neck",
  "hitgroup.gear": "Gear",
  "hitgroup.special": "Special",
  "hitgroup.unknown": "Hitbox {0}",

  // Looked up as command.<name>.help, where <name> is the Command in commands.jsonc — rename the
  // command there and this key has to follow it.
  "command.weaponstats.help": "Show your per-weapon kills, accuracy and headshot rate."
}
