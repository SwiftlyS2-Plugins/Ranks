<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Ranks_WeaponStats.Contract</AssemblyName>
    <RootNamespace>Ranks.WeaponStats.Contract</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Same reasoning as Ranks.Contract: the XML is worth shipping for the members that carry a
         real doc comment, without writing "Gets the weapon." on every record field. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <OutputPath>$(MSBuildThisFileDirectory)build/</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Separate from the plugin assembly because a consumer has to name IWeaponStatsApi at compile
       time, and referencing Ranks_WeaponStats.dll itself would put a second copy of the plugin on
       the server. References nothing, so it stays independent of both core and SwiftlyS2 versions. -->

</Project>
