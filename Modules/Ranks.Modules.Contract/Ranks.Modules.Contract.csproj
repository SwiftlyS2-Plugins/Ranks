<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Ranks.Modules.Contract</AssemblyName>
    <RootNamespace>Ranks.Modules.Contract</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Same reasoning as Ranks.Contract: the XML is worth shipping for the members that carry a
         real doc comment, without writing "Gets the weapon." on every record field. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <OutputPath>$(MSBuildThisFileDirectory)build/</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Deliberately references nothing, not even SwiftlyS2: every member here takes a SteamID64 and
       returns plain records, so a consumer can name these types without pulling in the framework.
       Ranks.Contract is also absent on purpose — a plugin may want WeaponStats data without
       touching core's API at all. -->

</Project>
