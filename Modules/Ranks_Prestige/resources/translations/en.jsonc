{
  // Shown by !prestige. Plain text — core's chat colours are applied by the framework.
  "command.prestige.help": "Shows your prestige level and progress",

  "error.players_only": "This command can only be used in-game.",
  "error.unavailable": "Prestige data is not available yet. Try again in a moment.",

  "prestige.disabled": "Prestige is currently disabled on this server.",
  // {0} is the level the player's CURRENT points reach. Points can fall, so this can fall too.
  "prestige.level": "Highest level reached: {0}",
  // {0} stored points, {1} the next level's threshold — both absolute, not per-level.
  "prestige.next": "Next level: {0}/{1}",
  "prestige.max": "You have reached the highest prestige.",

  // Doubles as the label core shows under its Statistics menu, so renaming it renames that row.
  "menu.prestige.title": "Prestige"
}
